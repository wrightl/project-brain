# Copy to http.env (gitignored) and configure for REST Client / VS Code HTTP files.
# Obtain user/coach/admin tokens via Auth0 login — client_credentials tokens lack user roles.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://localhost:7585
